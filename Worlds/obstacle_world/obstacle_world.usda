    def Scope "Looks" (
        kind = ""
    )
    {
        def Material "obstacles_mat"
        {
            token outputs:mdl:displacement.connect = </World/Looks/obstacles_mat/Shader.outputs:out>
            token outputs:mdl:surface.connect = </World/Looks/obstacles_mat/Shader.outputs:out>
            token outputs:mdl:volume.connect = </World/Looks/obstacles_mat/Shader.outputs:out>

            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @OmniPBR.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
                color3f inputs:diffuse_color_constant = (0.9498069, 0.0403393, 0.0403393)
                token outputs:out (
                    renderType = "material"
                )
            }
        }

        def Material "walls_mat"
        {
            token outputs:mdl:displacement.connect = </World/Looks/walls_mat/Shader.outputs:out>
            token outputs:mdl:surface.connect = </World/Looks/walls_mat/Shader.outputs:out>
            token outputs:mdl:volume.connect = </World/Looks/walls_mat/Shader.outputs:out>

            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @OmniPBR.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
                color3f inputs:diffuse_color_constant = (0.15830117, 0.1582996, 0.1582996)
                token outputs:out (
                    renderType = "material"
                )
            }
        }
    }

