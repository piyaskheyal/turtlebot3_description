            double3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
        }
    }

    over "base_link"
    {
    }

    over "caster_back_link"
    {
    }
    variantSet "Physics" = {
        "None" (
            prepend references = @./configuration/turtlebot3_burger_base.usd@
        ) {
            over "joints" (
                active = false
            )
            {
            }

        }
        "PhysX" (
            prepend payload = @./configuration/turtlebot3_burger_physics.usd@
