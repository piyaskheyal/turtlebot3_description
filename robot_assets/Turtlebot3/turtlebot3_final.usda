                prepend quatd inputs:orientation.connect = </turtlebot3_burger/Graphs/ROS_Odometry/ComputeOdometry.outputs:orientation>
                custom vector3d inputs:position
                prepend vector3d inputs:position.connect = </turtlebot3_burger/Graphs/ROS_Odometry/ComputeOdometry.outputs:position>
                custom bool inputs:publishRawVelocities
                custom string inputs:qosProfile
                custom uint64 inputs:queueSize
                custom vector3d inputs:robotFront
                custom double inputs:timeStamp
                prepend double inputs:timeStamp.connect = </turtlebot3_burger/Graphs/ROS_Odometry/ReadSimTime.outputs:simulationTime>
                custom string inputs:topicName = "/odom"
                token node:type = "isaacsim.ros2.bridge.ROS2PublishOdometry"
